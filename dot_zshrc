typeset -U path fpath

if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif (( $+commands[brew] )); then
    eval "$(brew shellenv)"
fi
if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi

if [[ -n $HOMEBREW_PREFIX ]]; then
    FPATH=$HOMEBREW_PREFIX/share/zsh-completions:$FPATH
fi
export HOMEBREW_NO_ENV_HINTS=1

[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH"

export HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=$HISTSIZE
setopt BANG_HIST
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt HIST_BEEP

setopt autocd

export CLICOLOR=1

alias l="lsd"
alias la="lsd -A"
alias ll="lsd -Alg"
alias lt="lsd --tree"

alias -g CP="| pbcopy"
alias -g RG="| rg"

alias ..='cd ..'
alias ...='cd ../..'

alias y=yazi
alias g=lazygit

if (( $+commands[nvim] )); then
    export EDITOR=nvim
else
    export EDITOR=vim
fi

alias e=$EDITOR

alias zreload="echo 'Reloading zsh...' && exec zsh"
alias zshrc="$EDITOR ~/.zshrc && zreload"

bindkey -e

autoload -z edit-command-line
zle -N edit-command-line
bindkey "^X^E" edit-command-line

my-backward-delete-word() {
    local WORDCHARS=${WORDCHARS/\//}
    zle backward-delete-word
}
zle -N my-backward-delete-word
bindkey '^W' my-backward-delete-word

if [[ -d "$HOME/.zextras" ]]; then
    if [[ -d "$HOME/.zextras/functions" ]]; then
        fpath=("$HOME/.zextras/functions" $fpath)
        autoload -Uz "$HOME/.zextras/functions"/*(N:t)
    fi
    for _zextra in "$HOME"/.zextras/*.zsh(N); do
        source "$_zextra"
    done
    unset _zextra
fi

autoload -Uz compinit
() {
    local dump=${ZDOTDIR:-$HOME}/.zcompdump
    local -a stale=( $dump(N.mh+24) )
    if (( $#stale )); then
        compinit -d $dump && touch $dump
    else
        compinit -C -d $dump
    fi
}

if (( $+commands[fzf] )); then
    eval "$(fzf --zsh)"
    export FZF_DEFAULT_OPTS="--height 40% --layout reverse --border=rounded --no-separator --info inline --preview-window down"
    export FZF_CTRL_R_OPTS="--with-nth 2.. --bind 'alt-t:change-with-nth(1..|2..)'"
    export FZF_CTRL_T_OPTS="--preview '(highlight -O ansi -l {} 2> /dev/null || cat {} || tree -C {}) 2> /dev/null | head -200'"
    export FZF_ALT_C_OPTS="--walker-skip .git,node_modules,target --preview 'eza --tree {}'"
    if (( $+commands[fd] )); then
        export FZF_DEFAULT_COMMAND="fd . $HOME"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        bindkey "ç" fzf-cd-widget
        export FZF_ALT_C_COMMAND="fd -t d . $HOME"
    fi
fi

if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
fi

ZSH_AUTOSUGGEST_MANUAL_REBIND=1

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
